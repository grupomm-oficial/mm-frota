rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // Helpers basicos
    // ============================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasCurrentUserDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserIsActive() {
      return hasCurrentUserDoc() && (
        !currentUserData().keys().hasAny(["active"]) ||
        currentUserData().active == true
      );
    }

    function isAppUser() {
      return isSignedIn() &&
        currentUserIsActive();
    }

    function isAdmin() {
      return currentUserIsActive() &&
        currentUserData().role == "admin";
    }

    function userStoreId() {
      return currentUserIsActive() ? currentUserData().storeId : null;
    }

    function hasStore(data) {
      return data.keys().hasAny(["storeId"]) &&
        data.storeId is string &&
        data.storeId != "";
    }

    function isSameStore(data) {
      return hasStore(data) &&
        userStoreId() == data.storeId;
    }

    function hasResponsibleId(data) {
      return data.keys().hasAny(["responsibleUserId"]) &&
        data.responsibleUserId is string;
    }

    function hasResponsibleIds(data) {
      return data.keys().hasAny(["responsibleUserIds"]) &&
        data.responsibleUserIds is list;
    }

    function isResponsibleIn(data) {
      return isAppUser() && (
        (
          hasResponsibleId(data) &&
          data.responsibleUserId == request.auth.uid
        ) ||
        (
          hasResponsibleIds(data) &&
          data.responsibleUserIds.hasAny([request.auth.uid])
        )
      );
    }

    function canAccessVehicleData(data) {
      return isAdmin() ||
        isResponsibleIn(data);
    }

    function hasVehicleId(data) {
      return data.keys().hasAny(["vehicleId"]) &&
        data.vehicleId is string &&
        data.vehicleId != "";
    }

    function linkedVehicleExists(data) {
      return hasVehicleId(data) &&
        exists(/databases/$(database)/documents/vehicles/$(data.vehicleId));
    }

    function linkedVehicleData(data) {
      return get(/databases/$(database)/documents/vehicles/$(data.vehicleId)).data;
    }

    function canOperateLinkedVehicle(data) {
      return isAppUser() &&
        linkedVehicleExists(data) &&
        canAccessVehicleData(linkedVehicleData(data));
    }

    function matchesLinkedVehicleStore(data) {
      return hasStore(data) &&
        linkedVehicleExists(data) &&
        linkedVehicleData(data).keys().hasAny(["storeId"]) &&
        linkedVehicleData(data).storeId == data.storeId;
    }

    function hasNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function adminAuditFieldsAreValid() {
      return isAdmin() &&
        request.resource.data.keys().hasAll([
          "updatedAt",
          "updatedById",
          "updatedByName",
          "editReason"
        ]) &&
        hasNonEmptyString(request.resource.data.updatedAt) &&
        request.resource.data.updatedById is string &&
        request.resource.data.updatedById == request.auth.uid &&
        hasNonEmptyString(request.resource.data.updatedByName) &&
        hasNonEmptyString(request.resource.data.editReason);
    }

    // ============================
    // Helpers de update restrito
    // ============================

    function vehicleOperationalUpdateOnly() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly([
        "status",
        "currentKm",
        "vehicleNotes",
        "updatedVehicleNotesAt",
        "updatedVehicleNotesById",
        "updatedVehicleNotesByName"
      ]) &&
        (
          !changed.hasAny(["updatedVehicleNotesById"]) ||
          request.resource.data.updatedVehicleNotesById == request.auth.uid
        );
    }

    function routeOperationalUpdateOnly() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly([
        "endKm",
        "endAt",
        "distanceKm",
        "status",
        "destino",
        "observacoes",
        "finishedAt",
        "finishedById",
        "finishedByName",
        "canceledAt",
        "canceledById",
        "canceledByName",
        "cancelReason",
        "updatedObsAt",
        "updatedObsById",
        "updatedObsByName"
      ]) &&
        (
          !changed.hasAny(["finishedById"]) ||
          request.resource.data.finishedById == request.auth.uid
        ) &&
        (
          !changed.hasAny(["canceledById"]) ||
          request.resource.data.canceledById == request.auth.uid
        ) &&
        (
          !changed.hasAny(["updatedObsById"]) ||
          request.resource.data.updatedObsById == request.auth.uid
        );
    }

    function maintenanceCompletionUpdateOnly() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return changed.hasOnly([
        "status",
        "endKm",
        "endDate"
      ]);
    }

    function routeAdminCorrectionAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return adminAuditFieldsAreValid() &&
        linkedVehicleExists(request.resource.data) &&
        matchesLinkedVehicleStore(request.resource.data) &&
        changed.hasOnly([
          "vehicleId",
          "vehiclePlate",
          "vehicleModel",
          "storeId",
          "driverId",
          "driverName",
          "origem",
          "destino",
          "startKm",
          "endKm",
          "startAt",
          "endAt",
          "distanceKm",
          "status",
          "responsibleUserId",
          "responsibleUserName",
          "observacoes",
          "finishedAt",
          "finishedById",
          "finishedByName",
          "canceledAt",
          "canceledById",
          "canceledByName",
          "cancelReason",
          "updatedObsAt",
          "updatedObsById",
          "updatedObsByName",
          "updatedAt",
          "updatedById",
          "updatedByName",
          "editReason"
        ]) &&
        request.resource.data.vehicleId is string &&
        request.resource.data.driverId is string &&
        request.resource.data.startKm is number &&
        (
          !request.resource.data.keys().hasAny(["endKm"]) ||
          request.resource.data.endKm == null ||
          request.resource.data.endKm is number
        ) &&
        (
          !request.resource.data.keys().hasAny(["distanceKm"]) ||
          request.resource.data.distanceKm == null ||
          request.resource.data.distanceKm is number
        ) &&
        (
          !request.resource.data.keys().hasAny(["cancelReason"]) ||
          request.resource.data.cancelReason == null ||
          request.resource.data.cancelReason is string
        );
    }

    function fuelingAdminCorrectionAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return adminAuditFieldsAreValid() &&
        linkedVehicleExists(request.resource.data) &&
        matchesLinkedVehicleStore(request.resource.data) &&
        changed.hasOnly([
          "vehicleId",
          "vehiclePlate",
          "vehicleModel",
          "storeId",
          "responsibleUserId",
          "responsibleUserName",
          "date",
          "odometerKm",
          "liters",
          "pricePerL",
          "total",
          "stationName",
          "updatedAt",
          "updatedById",
          "updatedByName",
          "editReason"
        ]) &&
        request.resource.data.vehicleId is string &&
        request.resource.data.odometerKm is number &&
        request.resource.data.odometerKm > 0 &&
        request.resource.data.liters is number &&
        request.resource.data.liters > 0 &&
        request.resource.data.pricePerL is number &&
        request.resource.data.pricePerL > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total > 0 &&
        (
          !request.resource.data.keys().hasAny(["stationName"]) ||
          request.resource.data.stationName == null ||
          request.resource.data.stationName is string
        );
    }

    function maintenanceAdminCorrectionAllowed() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return adminAuditFieldsAreValid() &&
        linkedVehicleExists(request.resource.data) &&
        matchesLinkedVehicleStore(request.resource.data) &&
        changed.hasOnly([
          "vehicleId",
          "vehiclePlate",
          "vehicleModel",
          "storeId",
          "responsibleUserId",
          "responsibleUserName",
          "date",
          "odometerKm",
          "cost",
          "type",
          "workshopName",
          "notes",
          "status",
          "endKm",
          "endDate",
          "updatedAt",
          "updatedById",
          "updatedByName",
          "editReason"
        ]) &&
        request.resource.data.vehicleId is string &&
        request.resource.data.odometerKm is number &&
        request.resource.data.odometerKm > 0 &&
        request.resource.data.cost is number &&
        request.resource.data.cost > 0 &&
        hasNonEmptyString(request.resource.data.type) &&
        (
          !request.resource.data.keys().hasAny(["endKm"]) ||
          request.resource.data.endKm == null ||
          request.resource.data.endKm is number
        ) &&
        (
          !request.resource.data.keys().hasAny(["workshopName"]) ||
          request.resource.data.workshopName == null ||
          request.resource.data.workshopName is string
        ) &&
        (
          !request.resource.data.keys().hasAny(["notes"]) ||
          request.resource.data.notes == null ||
          request.resource.data.notes is string
        );
    }

    // ============================
    // USERS
    // ============================
    match /users/{userId} {
      // Mantem leitura do proprio documento mesmo para inativos,
      // para o app conseguir identificar o bloqueio e encerrar a sessao.
      allow read: if isSelf(userId) || isAdmin();

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "mustChangePassword"
        ])
      );
    }

    // ============================
    // USERNAMES
    // ============================
    match /usernames/{username} {
      // Login ainda resolve um username conhecido por get direto.
      // Listagens/queries ficam bloqueadas para reduzir enumeracao de acessos.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // ============================
    // VEHICLES
    // - responsaveis leem apenas veiculos vinculados diretamente a eles.
    // - escrita operacional liberada so para admin ou responsavel com acesso ao veiculo.
    // ============================
    match /vehicles/{vehicleId} {
      allow read: if canAccessVehicleData(resource.data);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        canAccessVehicleData(resource.data) &&
        vehicleOperationalUpdateOnly()
      );
    }

    // ============================
    // DRIVERS
    // - leitura operacional liberada para usuarios ativos
    // - admin gerencia tudo
    // - responsavel da mesma loja pode criar/editar nome e status
    // ============================
    match /drivers/{driverId} {
      allow read: if isAppUser();

      allow create: if isAdmin() || (
        isResponsibleIn(request.resource.data) &&
        isSameStore(request.resource.data)
      );

      allow update: if isAdmin() || (
        isResponsibleIn(resource.data) &&
        isSameStore(resource.data) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "name",
          "active"
        ])
      );

      allow delete: if isAdmin();
    }

    // ============================
    // ROUTES
    // - criacao exige usuario responsavel e vinculo com veiculo permitido
    // - update comum cobre finalizar, cancelar e observacoes
    // ============================
    match /routes/{routeId} {
      allow read: if isAdmin() ||
        isResponsibleIn(resource.data) ||
        canOperateLinkedVehicle(resource.data);

      allow create: if isAdmin() || (
        isResponsibleIn(request.resource.data) &&
        canOperateLinkedVehicle(request.resource.data) &&
        matchesLinkedVehicleStore(request.resource.data)
      );

      allow update: if
        (
          isAdmin() &&
          routeAdminCorrectionAllowed()
        ) || (
          routeOperationalUpdateOnly() &&
          (
            isResponsibleIn(resource.data) ||
            canOperateLinkedVehicle(resource.data)
          )
        );

      allow delete: if isAdmin();
    }

    // ============================
    // FUELINGS
    // - criacao exige vinculo com veiculo permitido
    // - edicao/exclusao seguem admin-only como no front atual
    // ============================
    match /fuelings/{fuelingId} {
      allow read: if isAdmin() ||
        isResponsibleIn(resource.data) ||
        canOperateLinkedVehicle(resource.data);

      allow create: if isAdmin() || (
        isResponsibleIn(request.resource.data) &&
        canOperateLinkedVehicle(request.resource.data) &&
        matchesLinkedVehicleStore(request.resource.data)
      );

      allow update: if isAdmin() && fuelingAdminCorrectionAllowed();
      allow delete: if isAdmin();
    }

    // ============================
    // MAINTENANCES
    // - criacao exige vinculo com veiculo permitido
    // - update comum cobre conclusao de manutencao
    // ============================
    match /maintenances/{maintenanceId} {
      allow read: if isAdmin() ||
        isResponsibleIn(resource.data) ||
        canOperateLinkedVehicle(resource.data);

      allow create: if isAdmin() || (
        isResponsibleIn(request.resource.data) &&
        canOperateLinkedVehicle(request.resource.data) &&
        matchesLinkedVehicleStore(request.resource.data)
      );

      allow update: if
        (
          isAdmin() &&
          maintenanceAdminCorrectionAllowed()
        ) || (
          maintenanceCompletionUpdateOnly() &&
          (
            isResponsibleIn(resource.data) ||
            canOperateLinkedVehicle(resource.data)
          )
        );

      allow delete: if isAdmin();
    }

    // ============================
    // MONTHLY SUMMARIES
    // ============================
    match /monthlySummaries/{summaryId} {
      allow read: if isAppUser();
      allow create, update, delete: if isAdmin();
    }
  }
}
